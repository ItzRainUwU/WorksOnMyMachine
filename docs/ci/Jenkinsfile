// Copy to Jenkinsfile.  Configure a Linux agent with Python 3.11.9 available.
pipeline {
  agent any
  options { skipDefaultCheckout(true) }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Install locked dependencies') {
      steps {
        sh '''
          set -eu
          test "$(cat .python-version)" = "3.11.9"
          python3.11 -m venv .venv
          .venv/bin/python -m pip install --requirement requirements.txt --constraint requirements.lock
        '''
      }
    }
    stage('Offline tests') {
      steps { sh '.venv/bin/python -m pytest' }
    }
  }
}
